# =====================================
# 本机配置 (最先加载，不同步)
# =====================================
# 此文件在所有其他模块之前加载
# 可在此设置变量供后续模块使用
#
# 位置: ~/.zsh/local.zsh
# 注意: 此文件不会同步到 iCloud，仅存在于本机
#
# 提示: 运行 adotstatus 查看当前配置状态

# =====================================
# 设备标识
# =====================================
export DEVICE_NAME="MacBook"
# 示例:
# export DEVICE_NAME="MacBook-Work"     # 工作机
# export DEVICE_NAME="MacBook-Home"     # 家用机
# export DEVICE_NAME="MacBook-Dev"      # 开发机

# =====================================
# 模块开关
# =====================================
# 设为 false 可跳过加载对应模块

# SDK 模块 (NVM/SDKMAN/Conda)
# ADOT_LOAD_SDK=false

# 工作模块
# ADOT_LOAD_WORK=false

# =====================================
# NVM / Node.js
# =====================================
# sdk.zsh 使用懒加载: 首次调用 node/npm/nvm 时才初始化
# 如果需要指定默认 Node 版本:
#   nvm alias default 20
#
# 如果某些工具需要 node 在 PATH 中立即可用 (跳过懒加载):
# export PATH="$HOME/.nvm/versions/node/v20.20.0/bin:$PATH"

# =====================================
# 路径覆盖 (在 path.zsh 之前生效)
# =====================================

# Android SDK (非标准位置时设置)
# export ANDROID_SDK_ROOT="/custom/path/to/sdk"
# export ANDROID_HOME="$ANDROID_SDK_ROOT"

# Conda 路径 (如果安装在非标准位置)
# sdk.zsh 会自动检测: ~/miniforge3, ~/miniconda3, ~/anaconda3 等
# export CONDA_PREFIX="/custom/path/to/conda"

# =====================================
# 本机专属 PATH
# =====================================
# 高优先级 (添加到 PATH 开头)
# export PATH="/some/priority/bin:$PATH"

# 低优先级 (添加到 PATH 末尾)
# export PATH="$PATH:/path/to/local/bin"

# ----- 常用示例 -----
# AI 工具 CLI
# export PATH="$HOME/.codebuddy/bin:$PATH"
# export PATH="$HOME/.lmstudio/bin:$PATH"

# Flutter
# export PATH="$HOME/flutter/bin:$PATH"

# 个人脚本目录
# export PATH="$PATH:$HOME/.local/bin"

# =====================================
# 本机专属别名
# =====================================
# alias sublime="'/Applications/Sublime Text.app/Contents/SharedSupport/bin/subl'"
# alias sp="scrcpy"
# alias python="python3"
# alias pip="pip3"

# =====================================
# 代理设置
# =====================================
# export http_proxy="http://127.0.0.1:7890"
# export https_proxy="$http_proxy"
# export no_proxy="localhost,127.0.0.1,.local"

# =====================================
# 本机专属环境变量
# =====================================
# export MY_SECRET_KEY="xxx"
# export API_TOKEN="xxx"

